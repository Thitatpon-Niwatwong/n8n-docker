        {
            "parameters": {
                "operation": "executeQuery",
                "query": "-- 1) \u0e2a\u0e23\u0e49\u0e32\u0e07 schema \u0e08\u0e32\u0e01 expression (sanitize \u0e43\u0e2b\u0e49\u0e40\u0e1b\u0e47\u0e19\u0e0a\u0e37\u0e48\u0e2d\u0e17\u0e35\u0e48 PostgreSQL \u0e43\u0e0a\u0e49\u0e44\u0e14\u0e49)\nCREATE SCHEMA IF NOT EXISTS {{\n  $json.schema\n    .toLowerCase()\n    .replace(/[^a-zA-Z0-9_]/g, '_')\n}};\n\n-- 2) \u0e15\u0e32\u0e23\u0e32\u0e07 invoices: \u0e40\u0e01\u0e47\u0e1a \"\u0e02\u0e49\u0e2d\u0e21\u0e39\u0e25\u0e08\u0e23\u0e34\u0e07\" \u0e02\u0e2d\u0e07\u0e43\u0e1a\u0e01\u0e33\u0e01\u0e31\u0e1a\u0e20\u0e32\u0e29\u0e35\nCREATE TABLE IF NOT EXISTS {{\n  $json.schema\n    .toLowerCase()\n    .replace(/[^a-zA-Z0-9_]/g, '_')\n}}.invoices (\n    id SERIAL PRIMARY KEY,\n\n    invoice_number   TEXT,\n    date_raw         TEXT,\n    doc_title        TEXT,\n\n    vendor_name      TEXT,\n    vendor_vat_id    TEXT,\n    vendor_branch    TEXT,\n\n    net_amount       NUMERIC(15,2),\n    vat_amount       NUMERIC(15,2),\n    grand_total      NUMERIC(15,2),\n\n    name             TEXT UNIQUE,\n    path             TEXT UNIQUE,\n\n    -- \u0e01\u0e31\u0e19\u0e02\u0e49\u0e2d\u0e21\u0e39\u0e25\u0e0b\u0e49\u0e33 (invoice_number + vat_id + branch)\n    CONSTRAINT invoices_unique_triplet\n      UNIQUE (invoice_number, vendor_vat_id, vendor_branch),\n\n    created_at       TIMESTAMP DEFAULT NOW()\n);\n\n\n\n-- 3) \u0e15\u0e32\u0e23\u0e32\u0e07\u0e2a\u0e23\u0e38\u0e1b\u0e1c\u0e25\u0e15\u0e23\u0e27\u0e08\u0e2a\u0e2d\u0e1a / \u0e40\u0e1b\u0e23\u0e35\u0e22\u0e1a\u0e40\u0e17\u0e35\u0e22\u0e1a (true/false summary)\nCREATE TABLE IF NOT EXISTS {{\n  $json.schema\n    .toLowerCase()\n    .replace(/[^a-zA-Z0-9_]/g, '_')\n}}.invoice_check_summary (\n    id SERIAL PRIMARY KEY,\n\n    -- \u0e40\u0e0a\u0e37\u0e48\u0e2d\u0e21\u0e01\u0e31\u0e1a invoices \u0e41\u0e25\u0e30\u0e25\u0e1a\u0e15\u0e32\u0e21\u0e40\u0e21\u0e37\u0e48\u0e2d invoices \u0e16\u0e39\u0e01\u0e25\u0e1a\n    invoice_id INT REFERENCES {{\n      $json.schema\n        .toLowerCase()\n        .replace(/[^a-zA-Z0-9_]/g, '_')\n    }}.invoices(id) ON DELETE CASCADE,\n\n    -- composite key \u0e43\u0e0a\u0e49\u0e2a\u0e33\u0e2b\u0e23\u0e31\u0e1a upsert\n    invoice_number   TEXT NOT NULL,\n    vendor_vat_id    TEXT NOT NULL,\n    vendor_branch    TEXT NOT NULL,\n\n    -- boolean flags \u0e02\u0e2d\u0e07\u0e41\u0e15\u0e48\u0e25\u0e30 field\n    invoice_status            BOOLEAN,\n    buyer_vat_info_status     BOOLEAN,\n    invoice_number_status     BOOLEAN,\n    date_raw_status           BOOLEAN,\n    vendor_name_status        BOOLEAN,\n    vendor_vat_id_status      BOOLEAN,\n    vendor_vat_id_info_status BOOLEAN,\n    vendor_branch_status      BOOLEAN,\n    net_amount_status         BOOLEAN,\n    vat_amount_status         BOOLEAN,\n    grand_total_status        BOOLEAN,\n\n    -- presence flags\n    missing_in_pdf     BOOLEAN,\n    missing_in_excel   BOOLEAN,\n\n    -- summary\n    all_ok             BOOLEAN,\n\n    updated_at         TIMESTAMP DEFAULT NOW(),\n\n    -- unique constraint \u0e1b\u0e49\u0e2d\u0e07\u0e01\u0e31\u0e19\u0e02\u0e49\u0e2d\u0e21\u0e39\u0e25\u0e0b\u0e49\u0e33\n    CONSTRAINT uq_invoice_check_summary\n        UNIQUE (invoice_number, vendor_vat_id, vendor_branch)\n);\n\n-- 4) \u0e15\u0e32\u0e23\u0e32\u0e07\u0e40\u0e2b\u0e15\u0e38\u0e1c\u0e25\u0e25\u0e30\u0e40\u0e2d\u0e35\u0e22\u0e14: \u0e41\u0e16\u0e27\u0e25\u0e30 field + \u0e40\u0e2b\u0e15\u0e38\u0e1c\u0e25\nCREATE TABLE IF NOT EXISTS {{\n  $json.schema\n    .toLowerCase()\n    .replace(/[^a-zA-Z0-9_]/g, '_')\n}}.invoice_check_reasons (\n    id SERIAL PRIMARY KEY,\n\n    -- \u0e1c\u0e39\u0e01\u0e01\u0e31\u0e1a\u0e41\u0e16\u0e27\u0e43\u0e19 summary (\u0e25\u0e1a summary \u0e41\u0e25\u0e49\u0e27\u0e43\u0e2b\u0e49 reasons \u0e2b\u0e32\u0e22\u0e15\u0e32\u0e21)\n    check_id INT REFERENCES {{\n      $json.schema\n        .toLowerCase()\n        .replace(/[^a-zA-Z0-9_]/g, '_')\n    }}.invoice_check_summary(id) ON DELETE CASCADE,\n\n    -- field \u0e44\u0e2b\u0e19\u0e17\u0e35\u0e48\u0e15\u0e23\u0e27\u0e08 (\u0e40\u0e0a\u0e48\u0e19 'invoice_number', 'net_amount', 'vendor_name')\n    field_name   TEXT,\n\n    -- \u0e2a\u0e16\u0e32\u0e19\u0e30\u0e02\u0e2d\u0e07 field \u0e19\u0e31\u0e49\u0e19 (true = \u0e1c\u0e48\u0e32\u0e19, false = \u0e44\u0e21\u0e48\u0e1c\u0e48\u0e32\u0e19)\n    status BOOLEAN NOT NULL,\n\n    -- \u0e43\u0e2b\u0e49 reasons table \u0e40\u0e01\u0e47\u0e1a\u0e40\u0e09\u0e1e\u0e32\u0e30\u0e01\u0e23\u0e13\u0e35\u0e44\u0e21\u0e48\u0e1c\u0e48\u0e32\u0e19\u0e40\u0e17\u0e48\u0e32\u0e19\u0e31\u0e49\u0e19\n    CONSTRAINT reasons_only_for_false CHECK (status = FALSE),\n  \n    -- \u0e02\u0e49\u0e2d\u0e04\u0e27\u0e32\u0e21\u0e2d\u0e18\u0e34\u0e1a\u0e32\u0e22\u0e41\u0e1a\u0e1a\u0e2d\u0e48\u0e32\u0e19\u0e07\u0e48\u0e32\u0e22\n    message      TEXT,\n\n    -- \u0e04\u0e48\u0e32\u0e40\u0e1b\u0e23\u0e35\u0e22\u0e1a\u0e40\u0e17\u0e35\u0e22\u0e1a (optional)\n    expected_value TEXT,    -- \u0e04\u0e48\u0e32\u0e17\u0e35\u0e48\u0e04\u0e27\u0e23\u0e08\u0e30\u0e40\u0e1b\u0e47\u0e19 (\u0e40\u0e0a\u0e48\u0e19 \u0e08\u0e32\u0e01 DB)\n    actual_value   TEXT,    -- \u0e04\u0e48\u0e32\u0e17\u0e35\u0e48\u0e40\u0e08\u0e2d (\u0e40\u0e0a\u0e48\u0e19 \u0e08\u0e32\u0e01 Excel/LLM)\n\n    created_at   TIMESTAMP DEFAULT NOW()\n);\n\n-- 5) \u0e15\u0e32\u0e23\u0e32\u0e07\u0e43\u0e2b\u0e21\u0e48\u0e2a\u0e33\u0e2b\u0e23\u0e31\u0e1a Excel (\"\u0e23\u0e32\u0e22\u0e07\u0e32\u0e19\u0e20\u0e32\u0e29\u0e35\u0e0b\u0e37\u0e49\u0e2d\")\nCREATE TABLE IF NOT EXISTS {{\n  $json.schema\n    .toLowerCase()\n    .replace(/[^a-zA-Z0-9_]/g, '_')\n}}.excel_purchase_tax (\n    id SERIAL PRIMARY KEY,\n\n    invoice_number   TEXT,\n    date_raw         TEXT,\n    doc_title        TEXT,\n    vendor_name      TEXT,\n    vendor_vat_id    TEXT,\n    vendor_branch    TEXT,\n\n    net_amount       NUMERIC(15,2),\n    vat_amount       NUMERIC(15,2),\n    grand_total      NUMERIC(15,2),\n\n    created_at       TIMESTAMP DEFAULT NOW()\n);",
                "options": {}
            },
