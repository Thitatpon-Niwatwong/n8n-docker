        {
            "parameters": {
                "jsCode": "const items = $input.all();\n\nreturn items.map(item => {\n  const bin = item.binary?.data; \n\n  const directory = bin?.directory || \"\";\n  const fileName  = bin?.fileName  || \"\";\n\n  return {\n    json: {\n      fileName,\n      directory,\n      // full path \u0e23\u0e27\u0e21\u0e0a\u0e37\u0e48\u0e2d\u0e44\u0e1f\u0e25\u0e4c\u0e14\u0e49\u0e27\u0e22\n      path: directory\n        ? `${directory}/${fileName}`\n        : fileName\n    },\n    binary: item.binary   \n  };\n});\n"
            },
            "type": "n8n-nodes-base.code",
            "typeVersion": 2,
            "position": [
                -1072,
                272
            ],
            "id": "8f32caa7-4f54-4381-abbe-a6e40a3873c5",
            "name": "Extract File Info"
        },
        {
            "parameters": {
                "jsCode": "const items = $input.all();\n\n// \u0e14\u0e36\u0e07\u0e0a\u0e37\u0e48\u0e2d\u0e42\u0e1f\u0e25\u0e40\u0e14\u0e2d\u0e23\u0e4c\u0e2a\u0e38\u0e14\u0e17\u0e49\u0e32\u0e22 \u0e40\u0e0a\u0e48\u0e19 \"\u0e01\", \"\u0e02\", \"\u0e2a\u0e22\u0e32\u0e21\u0e1a\u0e35\u0e22\u0e39\"\nconst folder = items[0].json.directory.split('/').pop();\n\n// normalize unicode \u0e43\u0e2b\u0e49\u0e04\u0e07\u0e17\u0e35\u0e48\nconst normalized = folder.normalize(\"NFC\");\n\n// hash \u0e2a\u0e33\u0e2b\u0e23\u0e31\u0e1a schema\nconst schema = 's_' + Buffer.from(normalized).toString('hex').slice(0, 16);\n\n// \u0e04\u0e37\u0e19\u0e04\u0e48\u0e32\u0e1e\u0e23\u0e49\u0e2d\u0e21\u0e02\u0e49\u0e2d\u0e21\u0e39\u0e25\u0e40\u0e14\u0e34\u0e21\u0e17\u0e38\u0e01 item + binary \u0e40\u0e14\u0e34\u0e21\nreturn items.map(item => ({\n  json: {\n    ...item.json,\n    schema,\n  },\n  binary: item.binary,\n}));\n"
            },
            "type": "n8n-nodes-base.code",
            "typeVersion": 2,
            "position": [
                -864,
                272
            ],
            "id": "77208896-e824-44d1-8632-609a1ab2f1df",
            "name": "Hash Schema Name"
        },
        {
            "parameters": {
                "operation": "executeQuery",
                "query": "CREATE TABLE IF NOT EXISTS public.vat_companies (\n    id SERIAL PRIMARY KEY,\n\n    vat_id TEXT NOT NULL,\n    branch TEXT NOT NULL,\n\n    company_name TEXT,\n    address      TEXT,\n\n    created_at TIMESTAMP DEFAULT NOW(),\n    updated_at TIMESTAMP DEFAULT NOW(),\n\n    CONSTRAINT vat_company_unique UNIQUE (vat_id, branch)\n);\n\nCREATE TABLE IF NOT EXISTS public.workflow_errors (\n    id SERIAL PRIMARY KEY,\n    timestamp TIMESTAMP,\n    workflow_name TEXT,\n    workflow_id TEXT,\n    execution_id TEXT,\n    execution_url TEXT,\n    last_node TEXT,\n    error_message TEXT,\n    error_stack TEXT\n);\n",
                "options": {}
            },
            "type": "n8n-nodes-base.postgres",
            "typeVersion": 2.6,
            "position": [
                -576,
                -176
            ],
            "id": "29c33c80-199c-48e0-af1a-cffad693da07",
            "name": "Create Companies Table",
